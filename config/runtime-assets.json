        "url": "https://cdn.jsdelivr.net/npm/onnxruntime-web@1.26.0/dist/ort-wasm-simd-threaded.jsep.wasm",
        "purpose": "ONNX Runtime WebGPU/JSEP WebAssembly support asset."
      },
      {
        "name": "ort.wasm.min.js",
        "path": "ort/ort.wasm.min.js",
        "url": "https://cdn.jsdelivr.net/npm/onnxruntime-web@1.26.0/dist/ort.wasm.min.js",
        "purpose": "ONNX Runtime WASM browser loader."
      },
      {
        "name": "ort-wasm-simd-threaded.wasm",
