      "path": "models/xfeat_2048_dynamic.onnx",
      "url": "https://github.com/DavideCatto/XFeat-ONNX/releases/download/V1.0.0/xfeat.onnx",
      "license": "Apache-2.0",
      "source": "DavideCatto/XFeat-ONNX V1.0.0 export of verlab/accelerated_features XFeat.",
      "note": "Fast packaging fallback. Regenerate from canonicalExport when we want the extractor and matcher exported from the exact same noahzhy path."
    },
    {
      "id": "lighterglue-l3",
      "name": "lighterglue_L3.onnx",
      "path": "models/lighterglue_L3.onnx",
